#!/bin/sh
# dwm-settings-appearance-control — Theme + borderpx setzen
# Ergänzt dwm-settings-appearance (read-only inventory) um Mutationen.
set -eu

script_dir=$(
	unset CDPATH
	cd -- "$(dirname -- "$0")" && pwd
)

themes_file="${XDG_CONFIG_HOME:-$HOME/.config}/dwm-titus/themes.toml"
theme_apply_script="$script_dir/theme-apply.sh"

usage() {
	cat >&2 <<EOF
usage: $0 discover
       $0 list-themes
       $0 get-current
       $0 set-theme NAME
       $0 set-borderpx N
EOF
}

clean_field() {
	printf '%s' "$1" | tr '\011\015\012' '   '
}

fail() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

require_themes_file() {
	[ -f "$themes_file" ] || fail "themes.toml not found at $themes_file"
}

toml_get() {
	section=$1
	key=$2
	awk -v sec="[$section]" -v key="$key" '
		/^\[/ { in_sec = ($0 == sec) }
		in_sec && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			sub(/^[^=]*=[[:space:]]*/, "")
			gsub(/"/, "")
			gsub(/[[:space:]]+#.*$/, "")
			sub(/[[:space:]]+$/, "")
			print; exit
		}
	' "$themes_file"
}

toml_set() {
	section=$1
	key=$2
	value=$3
	tmp=$(mktemp)
	awk -v sec="[$section]" -v key="$key" -v val="$value" '
		BEGIN { in_sec = 0; done = 0; found_sec = 0 }
		/^\[/ {
			if (in_sec && !done) {
				print key " = \"" val "\""
				done = 1
			}
			in_sec = ($0 == sec)
			if (in_sec) found_sec = 1
			print
			next
		}
		in_sec && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" && !done {
			print key " = \"" val "\""
			done = 1
			next
		}
		{ print }
		END {
			if (in_sec && !done) {
				print key " = \"" val "\""
			}
			if (!found_sec) {
				print ""
				print sec
				print key " = \"" val "\""
			}
		}
	' "$themes_file" >"$tmp"
	mv "$tmp" "$themes_file"
}

list_themes() {
	require_themes_file
	awk '
		/^\[theme\./ {
			name = $0
			sub(/^\[theme\./, "", name)
			sub(/\]$/, "", name)
			print name
		}
	' "$themes_file"
}

current_theme() {
	require_themes_file
	toml_get "active" "theme"
}

current_borderpx() {
	require_themes_file
	val=$(toml_get "appearance" "borderpx")
	[ -n "$val" ] && printf '%s\n' "$val" || printf '1\n'
}

cmd_discover() {
	require_themes_file
	active=$(current_theme)
	borderpx=$(current_borderpx)

	printf 'appearance-protocol\t1\n'
	printf 'active\t%s\n' "$(clean_field "$active")"
	printf 'borderpx\t%s\n' "$borderpx"
	list_themes | while IFS= read -r name; do
		marker=0
		[ "$name" = "$active" ] && marker=1
		printf 'theme\t%s\t%s\n' "$name" "$marker"
	done
}

cmd_set_theme() {
	name=$1
	require_themes_file

	if ! list_themes | grep -Fxq -- "$name"; then
		fail "unknown theme: $name"
	fi

	toml_set "active" "theme" "$name"

	if [ -x "$theme_apply_script" ]; then
		"$theme_apply_script" >/dev/null 2>&1 || true
	fi
	if command -v pidof >/dev/null 2>&1; then
		dwm_pid=$(pidof dwm 2>/dev/null || true)
		[ -n "$dwm_pid" ] && kill -USR1 "$dwm_pid" 2>/dev/null || true
	fi

	printf 'ok\ttheme\t%s\n' "$(clean_field "$name")"
}

cmd_set_borderpx() {
	value=$1

	case "$value" in
	0|1|2|3) ;;
	*) fail "borderpx must be 0, 1, 2 or 3" ;;
	esac

	require_themes_file
	toml_set "appearance" "borderpx" "$value"

	if [ -x "$theme_apply_script" ]; then
		"$theme_apply_script" >/dev/null 2>&1 || true
	fi
	if command -v pidof >/dev/null 2>&1; then
		dwm_pid=$(pidof dwm 2>/dev/null || true)
		[ -n "$dwm_pid" ] && kill -USR1 "$dwm_pid" 2>/dev/null || true
	fi

	printf 'ok\tborderpx\t%s\n' "$value"
}

[ $# -ge 1 ] || {
	usage
	exit 2
}

action=$1
shift

case "$action" in
discover) cmd_discover ;;
list-themes) list_themes ;;
get-current)
	printf 'active\t%s\n' "$(clean_field "$(current_theme)")"
	printf 'borderpx\t%s\n' "$(current_borderpx)"
	;;
set-theme)
	[ $# -eq 1 ] || fail "set-theme requires exactly 1 argument"
	cmd_set_theme "$1"
	;;
set-borderpx)
	[ $# -eq 1 ] || fail "set-borderpx requires exactly 1 argument"
	cmd_set_borderpx "$1"
	;;
-h|--help|help)
	usage
	;;
*)
	usage
	exit 2
	;;
esac
